<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed from Phase 1 onward for the PokéAPI sync, and from Phase 2 for TheGamesDB. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Phase 7: hand a downloaded update APK to the system installer (PackageInstaller session);
         the user still enables "install unknown apps" for this app and confirms every install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".HallOfMemoriesApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HallOfMemories">

        <!--
          Phase 5 (Settings, in-app language picker): automatic persistence of the per-app
          language chosen with AppCompatDelegate.setApplicationLocales() — without this
          service/meta-data (autoStoreLocales) the preference would have to be saved by hand.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Phase 7: PackageInstaller session status (explicit PendingIntent from ApkInstaller). -->
        <receiver
            android:name=".data.update.UpdateInstallReceiver"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.HallOfMemories">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Phase 3: a content:// URI for the system camera app to write a Hall of Fame entry
          screenshot into (ActivityResultContracts.TakePicture). No CAMERA permission is declared
          here — the camera app itself holds it; this app only ever receives the finished photo.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
